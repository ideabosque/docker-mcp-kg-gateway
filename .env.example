# =============================================================================
# docker-mcp-kg-gateway — container environment (TEMPLATE)
# =============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored; this template is committed. NEVER put real secrets here.
#
# IMPORTANT: docker compose's env_file parser does NOT strip inline comments.
# A line like   KEY=value   # comment   sets KEY to "value   # comment".
# Keep every value on its own line with NOTHING after the value. Put notes on
# the comment lines above each variable.
#
# The image is generic and entirely env-driven: no secrets are baked in.
# docker-compose reads CONTAINER_PORT / GATEWAY_PORT for host port mapping and
# feeds the rest to the gateway, which forwards module settings (AWS, Neo4j,
# LLM, MCP) to each engine's Config.initialize().
# =============================================================================

# ── Port mapping ───────────────────────────────────────────────────────────
# CONTAINER_PORT is the host port; GATEWAY_PORT is the in-container bind port.
# Non-default host port: ../docker-silvaengine-gateway also publishes its
# gateway on 8765 by default, and both stacks may run at once. GATEWAY_PORT
# (in-container bind port, also used by the container's own healthcheck)
# stays 8765 — only the host-side publish port changes.
CONTAINER_PORT=8766
GATEWAY_PORT=8765
GATEWAY_HOST=0.0.0.0
# GATEWAY_WORKERS > 1 requires shared task/rate/SSE backends (see below).
GATEWAY_WORKERS=1
GATEWAY_CONTAINER_NAME=mcp-kg-gateway

# ── Route manifest ─────────────────────────────────────────────────────────
# The image bakes an MCP+KGE-only manifest at /app/routes.yaml and the
# Dockerfile sets GATEWAY_ROUTES_CONFIG_PATH=/app/routes.yaml, so no env var
# is needed for the default. docker-compose mounts ./routes.yaml over that
# path; edit it on the host + restart the container — no rebuild. To mount a
# different host file instead, set GATEWAY_ROUTES_HOST_FILE.
GATEWAY_ROUTES_HOST_FILE=./routes.yaml

# ── CORS ───────────────────────────────────────────────────────────────────
# "*" (or unset) = allow any origin WITHOUT credentials. Set a comma-separated
# list (e.g. https://app.example.com) to also allow credentials/cookies. A
# wildcard and credentials are mutually exclusive per spec.
GATEWAY_CORS_ORIGINS=*

# ── Performance tuning ──────────────────────────────────────────────────────
# Sync dispatch thread pool size.
GATEWAY_DISPATCH_WORKERS=32

# ── Auth (gateway) ──────────────────────────────────────────────────────────
# local | cognito
GATEWAY_AUTH_PROVIDER=local
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# token lifetime (minutes)
ACCESS_TOKEN_EXP=15
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional pre-minted permanent admin token (uncomment to use):
# ADMIN_STATIC_TOKEN=

# Local user file (optional). Drop users.json into ./data and uncomment:
# LOCAL_USER_FILE=/app/data/users.json

# ── AWS Cognito (only when GATEWAY_AUTH_PROVIDER=cognito) ───────────────────
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# COGNITO_APP_SECRET=
# COGNITO_JWKS_URL=

# ── Shared-store backends (required when GATEWAY_WORKERS > 1) ───────────────
# memory | dynamodb
GATEWAY_TASK_BACKEND=memory
GATEWAY_TASK_TTL=3600
# memory | dynamodb
GATEWAY_RATE_LIMIT_BACKEND=memory
GATEWAY_RATE_LIMIT=500
GATEWAY_RATE_WINDOW=60

# ── AWS (S3 file parsing for KGE, S3 package staging for MCP) ────────────────
# Optional — only needed if you use document-upload extraction (KGE) or S3-
# hosted MCP tool packages. Leave blank to disable those AWS-backed features.
region_name=us-west-2
aws_access_key_id=
aws_secret_access_key=

# =============================================================================
# PostgreSQL (metadata backend — optional bundled service)
# =============================================================================
# Both mcp_daemon_engine and knowledge_graph_engine persist metadata to
# PostgreSQL (db_backend=postgresql is forced in the image — no DynamoDB
# option). Two ways to provide Postgres:
#
#   A. Bundled: set COMPOSE_PROFILES=postgres (adds the postgres service) and
#               keep PG_HOST=postgres. POSTGRES_* must match PG_USER/PASSWORD/DB.
#   B. External: leave the profile OFF and point PG_* at your own Postgres
#                (e.g. PG_HOST=host.docker.internal or a remote host).
#
# knowledge_graph_engine uses a configurable table prefix (kge_ by default,
# see KGE_PG_TABLE_PREFIX) to avoid collisions in a shared database.
# mcp_daemon_engine uses its own literal table names. Tables are auto-created
# on gateway startup when initialize_tables=1.
PG_HOST=postgres
PG_PORT=5432
PG_USER=silvaengine
PG_PASSWORD=silvaengine
PG_DB=silvaengine
initialize_tables=1
# knowledge_graph_engine PostgreSQL table prefix (routes.yaml forwards this
# as knowledge_graph_engine.Config's pg_table_prefix override):
KGE_PG_TABLE_PREFIX=kge_
# overrides PG_* (alembic migrations) if set:
# DATABASE_URL=

# ── Bundled PostgreSQL service (profile: postgres) ──────────────────────────
POSTGRES_VERSION=17-alpine
POSTGRES_CONTAINER_NAME=mcp-kg-postgres
POSTGRES_USER=silvaengine
POSTGRES_PASSWORD=silvaengine
POSTGRES_DB=silvaengine
# Non-default host port: ../docker-silvaengine-gateway also bundles Postgres
# on 5432 by default, and both stacks may run at once. PG_PORT (used inside
# the docker network to reach the 'postgres' service) stays 5432 — only the
# host-side publish port changes.
POSTGRES_PORT=5433
# host dir for the PG data directory:
POSTGRES_DATA_PATH=./postgres_data
# host dir for PG log files:
POSTGRES_LOG_PATH=./postgres_logs
# none | ddl | mod | all:
LOG_STATEMENT=none
# log queries slower than N ms (-1 disables):
LOG_MIN_DURATION=1000

# =============================================================================
# Neo4j (Knowledge Graph Engine graph store — optional bundled service)
# =============================================================================
# Neo4j is ALWAYS required by knowledge_graph_engine, regardless of the
# metadata db_backend. Two ways to provide Neo4j:
#
#   A. Bundled: set COMPOSE_PROFILES=neo4j (adds the neo4j service) and keep
#               neo4j_uri=bolt://neo4j:7687. NEO4J_AUTH must match
#               neo4j_username/neo4j_password.
#   B. External: leave the profile OFF and point neo4j_uri at your own Neo4j
#                (e.g. bolt://host.docker.internal:7687).
neo4j_uri=bolt://neo4j:7687
neo4j_username=neo4j
neo4j_password=12345abc
neo4j_database=neo4j

# ── Bundled Neo4j service (profile: neo4j) ──────────────────────────────────
NEO4J_VERSION=5-community
NEO4J_CONTAINER_NAME=mcp-kg-neo4j
# Must match neo4j_username/neo4j_password above (user/password format):
NEO4J_AUTH=neo4j/12345abc
# Non-default host ports: ../docker-silvaengine-gateway also bundles Neo4j on
# 7474/7687 by default, and both stacks may run at once. neo4j_uri above
# (used inside the docker network to reach the 'neo4j' service) stays
# bolt://neo4j:7687 — only the host-side publish ports change.
NEO4J_BROWSER_PORT=7475
NEO4J_BOLT_PORT=7688
# host dir for data/logs/import/plugins:
NEO4J_HOST_DIR=./neo4j_data

# =============================================================================
# Compose profiles — the single switch for BOTH optional bundled databases
# =============================================================================
# Comma-separated. docker-compose reads this to start profile-gated services.
#   COMPOSE_PROFILES=                 gateway only (external Postgres + Neo4j)
#   COMPOSE_PROFILES=postgres         gateway + bundled Postgres
#   COMPOSE_PROFILES=neo4j            gateway + bundled Neo4j
#   COMPOSE_PROFILES=postgres,neo4j   gateway + bundled Postgres AND Neo4j
COMPOSE_PROFILES=postgres,neo4j

# =============================================================================
# Knowledge Graph Engine — LLM settings (entity extraction, text2cypher, RAG)
# =============================================================================
llm_type=openai
llm_name=gpt-4o
openai_api_key=
embedding_model=text-embedding-3-small

# =============================================================================
# MCP Daemon Engine
# =============================================================================
# MCP tool packages (functs) are extracted under /app/data on the gateway
# container (bind-mounted from ./data on the host).
FUNCT_BUCKET_NAME=
FUNCT_ZIP_PATH=/app/data/funct_zips
FUNCT_EXTRACT_PATH=/app/data/functs
